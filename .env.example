# =============================================================================
# Clubes — Variables de entorno
# Copiá este archivo a .env y completá los valores.
#
# Hay dos contextos de uso:
#   LOCAL : .env en la raíz del repo (lo lee el backend con uvicorn)
#   VPS   : /home/deploy/defensores/.env (lo lee docker-compose.prod.yml)
# Cada variable indica dónde aplica.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (MariaDB) — LOCAL y VPS
# Formato: mysql://usuario:contraseña@host:3306/base
# -----------------------------------------------------------------------------
# LOCAL (MariaDB de Laragon):
DATABASE_URL="mysql://root@localhost:3306/clubes_db"
# VPS (MariaDB del host, visto desde el contenedor):
# DATABASE_URL="mysql://clubes_user:una-clave-fuerte@host.docker.internal:3306/clubes_db"

# -----------------------------------------------------------------------------
# Puerto — solo VPS
# Puerto del host donde el compose publica la app (Nginx apunta acá).
# En local no se usa: uvicorn define el puerto por CLI (--port 3001).
# -----------------------------------------------------------------------------
PORT=3030

# -----------------------------------------------------------------------------
# Seguridad — LOCAL y VPS
# JWT_SECRET: mínimo 32 caracteres (la app no arranca si es más corto).
# QR_SECRET: firma los QR de carnets; si falta, usa JWT_SECRET.
# Generar cada uno con: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres"
QR_SECRET="cambia-esto-por-otro-secret-largo-para-los-codigos-qr-de-socios"

# -----------------------------------------------------------------------------
# URLs — LOCAL y VPS
# FRONTEND_URL: origen permitido por CORS (el next dev local) y base de las
#               back_urls de Mercado Pago.
# API_PUBLIC_URL: URL pública del webhook de Mercado Pago.
# -----------------------------------------------------------------------------
# LOCAL:
FRONTEND_URL="http://localhost:3000"
API_PUBLIC_URL=""
# VPS:
# FRONTEND_URL="https://defensores.yacarestudio.com"
# API_PUBLIC_URL="https://defensores.yacarestudio.com/api/payments/mercado-pago/webhook"

# -----------------------------------------------------------------------------
# Primer arranque (seed) — LOCAL y VPS
# Crea la configuración del club y el usuario admin si no existen.
# En el VPS: NUNCA dejar la contraseña por defecto.
# SEED_DEMO=1 carga contenido de ejemplo (solo demos/desarrollo).
# -----------------------------------------------------------------------------
CLUB_NAME="Club Atlético Defensores de Vilelas"
ADMIN_EMAIL="admin@clubes.local"
ADMIN_PASSWORD="admin123"
SEED_DEMO=1

# -----------------------------------------------------------------------------
# Imagen a deployar — solo VPS
# La publica el workflow de GitHub Actions. Para rollback: usar el tag <sha>.
# -----------------------------------------------------------------------------
# DEPLOY_IMAGE="ghcr.io/TU_USUARIO/TU_REPO:latest"

# -----------------------------------------------------------------------------
# Mercado Pago — opcional (LOCAL y VPS)
# Lo normal es cargar las credenciales desde el admin (quedan en la base);
# estas variables son solo fallback.
# -----------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Archivos del club — opcional
# Carpeta persistente servida en /recursos (fotos de socios, documentos).
# LOCAL: default <raíz del repo>/recursos. VPS: el compose ya la fija en
# /app/recursos (volumen ./recursos), no hace falta definirla.
# -----------------------------------------------------------------------------
# RECURSOS_DIR=""

# -----------------------------------------------------------------------------
# Docker Compose de DESARROLLO (docker-compose.yml) — solo local
# Credenciales del MariaDB que levanta el compose local (host puerto 3307).
# -----------------------------------------------------------------------------
DB_PASSWORD="clubes_pass"
DB_ROOT_PASSWORD="root_pass"
