# Clubes -copiá a .env y completá.
# LOCAL: .env en la raíz del repo · VPS: /home/deploy/defensores/.env

# LOCAL: mysql://root@localhost:3306/clubes_db
# VPS:   mysql://clubes_user:clubes_pass@host.docker.internal:3306/clubes_db
DATABASE_URL="mysql://root@localhost:3306/clubes_db"

# Mínimo 32 caracteres - generar cada uno con: openssl rand -hex 32
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres"
QR_SECRET="cambia-esto-por-otro-secret-largo-para-los-codigos-qr"

# LOCAL: http://localhost:3000 (CORS del next dev) · VPS: https://defensores.yacarestudio.com
# Es el único origen al que se le habilita CORS (en el VPS web y API comparten origen)
FRONTEND_URL="https://defensores.yacarestudio.com"

# Opcional - zona horaria del club (IANA). Define "hoy", el mes y el cierre de caja.
# La base guarda todo en UTC; la web muestra siempre esta hora.
# CLUB_TIMEZONE="America/Argentina/Buenos_Aires"

# Opcional - clave Fernet para cifrar en la base las credenciales de Mercado Pago.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin ella se deriva de JWT_SECRET (rotar JWT_SECRET obliga a recargar las credenciales de MP).
# SECRETS_KEY=""

# Documentación de la API en /api/docs (1 = visible; el compose de prod la apaga por defecto)
# ENABLE_DOCS=1

# Opcional - errores a Sentry o GlitchTip (self-hosted). Sin DSN no se envía nada.
# SENTRY_DSN=""
# APP_ENV=production
# LOG_LEVEL=INFO

# Solo VPS - backups (scripts/backup.sh): carpeta, retención y copia fuera del VPS con rclone
# BACKUP_DIR=/home/deploy/backups/defensores
# BACKUP_RETENTION_DAYS=14
# BACKUP_RCLONE_REMOTE=b2:clubes-backups/defensores

# Solo VPS - puerto del host que publica el compose (Nginx apunta acá)
PORT=3030

# Solo VPS -  webhook de Mercado Pago
# API_PUBLIC_URL="https://defensores.yacarestudio.com/api/payments/mercado-pago/webhook"

# Seed del primer arranque (VPS: contraseña fuerte y SEED_DEMO=0)
CLUB_NAME="Club Atlético Defensores de Vilelas"
ADMIN_EMAIL="admin@defensores.com"
ADMIN_PASSWORD="cambiar-por-una-clave-fuerte"
SEED_DEMO=1
