# Clubes -copiá a .env y completá.
# LOCAL: .env en la raíz del repo · VPS: /home/deploy/defensores/.env

# LOCAL: mysql://root@localhost:3306/clubes_db
# VPS:   mysql://clubes_user:clubes_pass@host.docker.internal:3306/clubes_db
DATABASE_URL="mysql://root@localhost:3306/clubes_db"

# Mínimo 32 caracteres - generar cada uno con: openssl rand -hex 32
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres"
QR_SECRET="cambia-esto-por-otro-secret-largo-para-los-codigos-qr"

# LOCAL: http://localhost:3000 (CORS del next dev) · VPS: https://defensores.yacarestudio.com
FRONTEND_URL="https://defensores.yacarestudio.com"

# Solo VPS - puerto del host que publica el compose (Nginx apunta acá)
PORT=3030

# Solo VPS -  webhook de Mercado Pago
# API_PUBLIC_URL="https://defensores.yacarestudio.com/api/payments/mercado-pago/webhook"

# Seed del primer arranque (VPS: contraseña fuerte y SEED_DEMO=0)
CLUB_NAME="Club Atlético Defensores de Vilelas"
ADMIN_EMAIL="admin@defensores.com"
ADMIN_PASSWORD="cambiar-por-una-clave-fuerte"
SEED_DEMO=1
